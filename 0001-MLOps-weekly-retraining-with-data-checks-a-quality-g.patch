index 0000000..411f1da
--- /dev/null
+++ b/ml/MLOPS.md
@@ -0,0 +1,48 @@
+# How the suitability model is kept fresh and safe
+
+The crop suitability model is retrained every week by Airflow. It only replaces the model
+in use if it passes a quality gate. This page explains each piece in plain words.
+
+## The weekly run (`dags/planting_ml_retraining.py`)
+
+Every Sunday at 09:00 (after the daily data pipeline has finished):
+
+1. **Rebuild the model inputs.** `dbt build` refreshes `mart_species_city_suitability` and
+   the tables it depends on.
+2. **Retrain with safety checks.** `python -m ml.mlops.retrain_suitability`
+
+## What the retraining step does (`ml/mlops/retrain_suitability.py`)
+
+| Step | What it checks | If it fails |
+|---|---|---|
+| Data health (`data_checks.py`) | Enough cities and crops, no duplicate pairs, no mostly-empty feature, both answers present in the label | Stops. Nothing changes. |
+| Has the data changed? | A fingerprint of the training table is compared with the one behind the live model | Stops quietly: nothing new to learn. `--force` overrides. |
+| Train and test | Every city is scored by a model that never saw it, and compared with two simple baselines | - |
+| Quality gate (`quality_gate.py`) | The model still beats the best baseline, and is not clearly worse than the live model (more than 0.03 AUC lower) | The run is recorded as **rejected**. The old model and scores stay live. The Airflow task turns red so someone looks. |
+| Publish (`run_history.py`) | - | Accepted runs become the live model; scores and reasons tables are replaced. |
+
+A gain over the baseline whose 95% range includes zero is **not** a rejection, but it is
+printed as a warning, because with this few cities it may be chance.
+
+## Where to look
+
+- **Run folders:** `ml/saved_models/suitability_runs/<run_id>/` holds each run's `model.pkl`
+  and `report.json` (test results, decision, reasons, data fingerprint).
+- **Database table:** `ml_training_runs`, one row per run, in the marts schema.
+- **API:** `GET /model/runs` lists recent runs, newest first. `GET /model` describes the live model.
+- **Live files** (only ever written by an accepted run):
+  `ml/saved_models/suitability_model.pkl`, `ml/evaluation_reports/suitability_latest.json`.
+
+## Running it by hand
+
+    python -m ml.mlops.retrain_suitability           # normal, with all checks
+    python -m ml.mlops.retrain_suitability --force   # even if the data has not changed
+    python -m ml.models.train_suitability --dry-run  # only print the test results, save nothing
+
+## What this does not do (yet)
+
+- It cannot tell whether recommendations are *right* for farmers. The label is a recording
+  proxy (crop recorded near the city), so the tests measure how well the model agrees with
+  recordings on unseen cities, not yield.
+- No alerting beyond the failed Airflow task.
+- No tracking of how the live data drifts over time beyond the fingerprint changing.
diff --git a/ml/mlops/data_checks.py b/ml/mlops/data_checks.py
new file mode 100644
index 0000000..a11c038
--- /dev/null
+++ b/ml/mlops/data_checks.py
@@ -0,0 +1,60 @@
+"""
+Checks on the training data, run BEFORE a model is trained.
+
+WHY
+  A model trained on a broken table still produces scores, and nobody notices.
+  These checks stop the run early and say in plain words what is wrong.
+
+TWO THINGS HERE
+  problems_with_training_data(df)  ->  a list of plain sentences; an empty list means "fine"
+  data_fingerprint(df)             ->  a short code that changes whenever the data changes,
+                                       so an unchanged week does not trigger a pointless retrain
+"""
+
+import hashlib
+
+import pandas as pd
+
+from ml.models.train_suitability import FEATURES, LABEL
+
+MIN_CITIES = 20           # the model is tested city by city, so it needs a fair number of cities
+MIN_CROPS = 10
+MAX_EMPTY_SHARE = 0.60    # a feature that is empty in more than this share of rows is not usable
+
+
+def problems_with_training_data(df: pd.DataFrame) -> list:
+    problems = []
+
+    missing_columns = [name for name in FEATURES + [LABEL, "city", "species"] if name not in df.columns]
+    if missing_columns:
+        # Nothing else can be checked without these columns.
+        return [f"The table is missing columns the model needs: {', '.join(missing_columns)}."]
+
+    if df["city"].nunique() < MIN_CITIES:
+        problems.append(f"Only {df['city'].nunique()} cities; at least {MIN_CITIES} are needed for a fair test.")
+    if df["species"].nunique() < MIN_CROPS:
+        problems.append(f"Only {df['species'].nunique()} crops; at least {MIN_CROPS} are needed.")
+
+    if df.duplicated(["city", "species"]).any():
+        problems.append("Some city and crop pairs appear more than once.")
+
+    if df[LABEL].nunique() < 2:
+        problems.append("Every crop-city pair has the same recorded/not-recorded answer, so nothing can be learned.")
+
+    numbers = df[FEATURES].apply(pd.to_numeric, errors="coerce")
+    for name in FEATURES:
+        empty_share = numbers[name].isna().mean()
+        if empty_share > MAX_EMPTY_SHARE:
+            problems.append(f"'{name}' is empty in {empty_share:.0%} of rows (limit {MAX_EMPTY_SHARE:.0%}).")
+
+    return problems
+
+
+def data_fingerprint(df: pd.DataFrame) -> str:
+    """
+    A 16-character code for the exact training data. Same data in any row order gives the
+    same code; any changed value, added city or removed crop gives a different one.
+    """
+    columns = ["city", "species", LABEL] + FEATURES
+    ordered = df[columns].sort_values(["city", "species"]).reset_index(drop=True)
+    return hashlib.sha256(ordered.to_csv(index=False).encode()).hexdigest()[:16]
diff --git a/ml/mlops/quality_gate.py b/ml/mlops/quality_gate.py
new file mode 100644
index 0000000..5233dad
--- /dev/null
+++ b/ml/mlops/quality_gate.py
@@ -0,0 +1,52 @@
+"""
+The quality gate: decides whether a freshly trained model may replace the one in use.
+
+THE RULE IN ONE LINE
+  A new model is published only if it is still better than the simple baselines on cities
+  it has never seen, and not clearly worse than the model it would replace.
+  Otherwise the previous scores stay live and the run is recorded as "rejected".
+
+Each rule below is a plain sentence, so a rejection explains itself.
+"""
+
+# How much worse than the model in use is tolerated, in AUC points (0.5 = guessing, 1.0 = perfect).
+# Small ups and downs between runs are normal when the data changes a little.
+MAX_DROP_VS_CURRENT_MODEL = 0.03
+
+ACCEPTED = "accepted"
+REJECTED = "rejected"
+
+
+def reasons_to_reject(results: dict, current_model_results: dict = None) -> list:
+    """
+    results               the test results of the new model (from train_suitability.evaluate)
+    current_model_results the test results of the model now in use, or None for the first run
+    Returns plain sentences. An empty list means the new model may be published.
+    """
+    reasons = []
+
+    gain = results["model_beats_best_baseline_by_auc"]
+    if gain <= 0:
+        reasons.append(
+            f"The model does not beat the best simple baseline ({results['best_baseline']}): "
+            f"gain is {gain:+.3f} AUC."
+        )
+
+    if current_model_results is not None:
+        new_auc = results["model"]["roc_auc"]
+        current_auc = current_model_results["model"]["roc_auc"]
+        if new_auc < current_auc - MAX_DROP_VS_CURRENT_MODEL:
+            reasons.append(
+                f"The new model is clearly worse than the one in use: AUC {new_auc:.3f} "
+                f"versus {current_auc:.3f} (more than {MAX_DROP_VS_CURRENT_MODEL} lower)."
+            )
+
+    return reasons
+
+
+def warnings(results: dict) -> list:
+    """Things worth a human look that do not block publishing."""
+    low, high = results["gain_95_percent_range"]
+    if low <= 0 < results["model_beats_best_baseline_by_auc"]:
+        return [f"The gain over the baseline could be chance: its 95% range is {low:.3f} to {high:.3f}."]
+    return []
diff --git a/ml/mlops/retrain_suitability.py b/ml/mlops/retrain_suitability.py
new file mode 100644
index 0000000..3da44b5
--- /dev/null
+++ b/ml/mlops/retrain_suitability.py
@@ -0,0 +1,86 @@
+"""
+Weekly retraining of the suitability model, with safety checks. Airflow runs this.
+
+WHAT HAPPENS, IN ORDER
+  1. Load the training table from the database.
+  2. Check the data is healthy.                      -> unhealthy: stop, change nothing
+  3. Has the data changed since the live model?      -> unchanged: stop, nothing to learn
+  4. Train and test on cities the model has not seen.
+  5. Quality gate: still better than the baselines?  -> no: keep the old scores, record "rejected"
+  6. Save the run (folder + database row).
+  7. If accepted: make it live and replace the scores and reasons the app reads.
+
+EXIT CODE
+  0  finished normally (accepted, or nothing to do)
+  1  stopped on purpose (unhealthy data or rejected model); Airflow marks the task failed
+     so someone looks, while the app keeps serving the previous scores.
+
+RUN BY HAND
+  python -m ml.mlops.retrain_suitability            # normal run
+  python -m ml.mlops.retrain_suitability --force    # retrain even if the data has not changed
+"""
+
+import argparse
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parent.parent.parent))
+
+from ml.explainability.explain_suitability import build_explanations  # noqa: E402
+from ml.mlops import quality_gate, run_history  # noqa: E402
+from ml.mlops.data_checks import data_fingerprint, problems_with_training_data  # noqa: E402
+from ml.models.train_suitability import (  # noqa: E402
+    FEATURES, fit_final_model, scores_to_save, train_and_evaluate,
+)
+from ml.utils.db import get_engine, load_suitability_features, marts_schema, save_predictions  # noqa: E402
+
+
+def retrain(force: bool = False) -> int:
+    """Runs the steps above. Returns the exit code."""
+    df = load_suitability_features()
+
+    problems = problems_with_training_data(df)
+    if problems:
+        print("[retrain] STOPPED: the training data is not healthy.")
+        for problem in problems:
+            print(f"  - {problem}")
+        return 1
+
+    engine, schema = get_engine(), marts_schema()
+    fingerprint = data_fingerprint(df)
+    if not force and fingerprint == run_history.last_accepted_fingerprint(engine, schema):
+        print(f"[retrain] Data unchanged since the live model ({fingerprint}). Nothing to do.")
+        return 0
+
+    scored, contributions, results = train_and_evaluate(df)
+    reasons = quality_gate.reasons_to_reject(results, run_history.live_results())
+    warnings = quality_gate.warnings(results)
+    status = quality_gate.REJECTED if reasons else quality_gate.ACCEPTED
+
+    run_id = run_history.new_run_id()
+    folder = run_history.save_run(run_id, fit_final_model(df), FEATURES, results,
+                                  status, reasons, warnings, fingerprint)
+    run_history.record_in_database(engine, schema, run_id, results, status, reasons,
+                                   fingerprint, rows=len(df))
+    print(f"[retrain] Run {run_id}: {status}. {results['verdict']}")
+    for warning in warnings:
+        print(f"  warning: {warning}")
+
+    if reasons:
+        print("[retrain] REJECTED. The previous model and scores stay live.")
+        for reason in reasons:
+            print(f"  - {reason}")
+        return 1
+
+    run_history.make_live(folder)
+    save_predictions(scores_to_save(scored), "ml_species_city_suitability")
+    save_predictions(build_explanations(df, contributions, top_k=3), "ml_species_city_explanations")
+    print("[retrain] Published: new model, scores and reasons are live.")
+    return 0
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Retrain the suitability model with safety checks.")
+    parser.add_argument("--force", action="store_true",
+                        help="retrain even if the data has not changed since the live model")
+    sys.exit(retrain(force=parser.parse_args().force))
diff --git a/ml/mlops/run_history.py b/ml/mlops/run_history.py
new file mode 100644
index 0000000..5b9255c
--- /dev/null
+++ b/ml/mlops/run_history.py
@@ -0,0 +1,99 @@
+"""
+Remembers every training run, so you can answer: "what is live, and how did we get here?"
+
+WHAT IS SAVED PER RUN
+  A dated folder  ml/saved_models/suitability_runs/<run_id>/
+      model.pkl     the trained model
+      report.json   the test results, the gate's decision and the data fingerprint
+  One row in the database table  ml_training_runs  (same facts, easy to query and show in the app)
+
+WHAT "LIVE" MEANS
+  Only an accepted run is copied to the two files the rest of the system reads:
+      ml/saved_models/suitability_model.pkl
+      ml/evaluation_reports/suitability_latest.json
+  A rejected run is kept for inspection but never goes live.
+"""
+
+import json
+import pickle
+import shutil
+from datetime import datetime
+from pathlib import Path
+
+import pandas as pd
+from sqlalchemy import text
+
+from ml.mlops.quality_gate import ACCEPTED
+
+ML_DIR = Path(__file__).parent.parent
+RUNS_DIR = ML_DIR / "saved_models" / "suitability_runs"
+LIVE_MODEL = ML_DIR / "saved_models" / "suitability_model.pkl"
+LIVE_REPORT = ML_DIR / "evaluation_reports" / "suitability_latest.json"
+RUNS_TABLE = "ml_training_runs"
+
+
+def new_run_id() -> str:
+    """Sorts oldest to newest, e.g. 2026-10-09_19-20-46-512 (the last part is milliseconds)."""
+    now = datetime.now()
+    return now.strftime("%Y-%m-%d_%H-%M-%S") + f"-{now.microsecond // 1000:03d}"
+
+
+def save_run(run_id: str, model, features: list, results: dict, status: str,
+             reasons: list, warnings: list, fingerprint: str) -> Path:
+    """Writes the run's folder and returns it."""
+    folder = RUNS_DIR / run_id
+    folder.mkdir(parents=True)  # fails if the folder exists: a past run is never overwritten
+    with open(folder / "model.pkl", "wb") as f:
+        pickle.dump({"model": model, "features": features}, f)
+    report = results | {"run_id": run_id, "status": status, "rejected_because": reasons,
+                        "warnings": warnings, "data_fingerprint": fingerprint}
+    (folder / "report.json").write_text(json.dumps(report, indent=2))
+    return folder
+
+
+def make_live(run_folder: Path) -> None:
+    """Copies an accepted run to the files the API and the AI layer read."""
+    LIVE_MODEL.parent.mkdir(parents=True, exist_ok=True)
+    LIVE_REPORT.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(run_folder / "model.pkl", LIVE_MODEL)
+    shutil.copyfile(run_folder / "report.json", LIVE_REPORT)
+
+
+def live_results():
+    """Test results of the model now in use, or None if no model has been published yet."""
+    if not LIVE_REPORT.exists():
+        return None
+    return json.loads(LIVE_REPORT.read_text())
+
+
+def record_in_database(engine, schema: str, run_id: str, results: dict, status: str,
+                       reasons: list, fingerprint: str, rows: int) -> None:
+    """Adds one row to ml_training_runs (the table is created on first use)."""
+    row = pd.DataFrame([{
+        "run_id": run_id,
+        "trained_at": results["trained_at"],
+        "status": status,
+        "rejected_because": " | ".join(reasons),
+        "data_fingerprint": fingerprint,
+        "rows_used": rows,
+        "cities": results["cities"],
+        "model_auc": results["model"]["roc_auc"],
+        "best_baseline": results["best_baseline"],
+        "gain_over_baseline_auc": results["model_beats_best_baseline_by_auc"],
+        "gain_range_low": results["gain_95_percent_range"][0],
+        "gain_range_high": results["gain_95_percent_range"][1],
+        "top_n_hit_rate": results["model"]["top_n_hit_rate"],
+    }])
+    row.to_sql(RUNS_TABLE, engine, schema=schema, if_exists="append", index=False)
+
+
+def last_accepted_fingerprint(engine, schema: str):
+    """Fingerprint of the data behind the live model, or None if there is none (or no table yet)."""
+    query = text(f"SELECT data_fingerprint FROM {schema}.{RUNS_TABLE} "
+                 f"WHERE status = :status ORDER BY run_id DESC LIMIT 1")
+    try:
+        with engine.connect() as conn:
+            row = conn.execute(query, {"status": ACCEPTED}).first()
+    except Exception:  # the table does not exist before the first run
+        return None
+    return row[0] if row else None
