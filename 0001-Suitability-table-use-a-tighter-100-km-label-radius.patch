diff --git a/dbt/dbt_project.yml b/dbt/dbt_project.yml
index 96e8415..296af26 100644
--- a/dbt/dbt_project.yml
+++ b/dbt/dbt_project.yml
@@ -29,6 +29,9 @@ clean-targets: ["target", "dbt_packages"]
 vars:
   # A species counts as "near" a city if it was observed within this many km.
   species_radius_km: 500
