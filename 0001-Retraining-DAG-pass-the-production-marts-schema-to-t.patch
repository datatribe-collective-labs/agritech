From 951db8a723219401f99b5e847e2205f5d2593006 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 9 Oct 2026 19:57:59 +0300
Subject: [PATCH] Retraining DAG: pass the production marts schema to the
 retrain step

The retrain task looked for the tables in public_marts (the local default) and failed
in production, where dbt writes to planting_intelligence_marts.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012HbcbvEafNFn6aR2BmUheY
---
 dags/planting_ml_retraining.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dags/planting_ml_retraining.py b/dags/planting_ml_retraining.py
index 32fabf5..2f2a397 100644
--- a/dags/planting_ml_retraining.py
+++ b/dags/planting_ml_retraining.py
@@ -23,6 +23,10 @@ from airflow.operators.bash import BashOperator
 
 REPO = "/root/agritech"
 DBT_COMMAND = f"{REPO}/venvs/dbt/bin/dbt"
+
+# Where dbt writes the mart tables in production. The ML code defaults to the local
+# docker name (public_marts), so the production name must be given to it explicitly.
+PRODUCTION_MARTS_SCHEMA = "planting_intelligence_marts"
 ML_PYTHON = f"{REPO}/venvs/ml/bin/python"
 
 default_args = {
@@ -53,6 +57,8 @@ with DAG(
         task_id="retrain_and_publish_if_good_enough",
         bash_command=f"cd {REPO} && {ML_PYTHON} -m ml.mlops.retrain_suitability",
         execution_timeout=timedelta(minutes=30),
+        env={"PLANTING_MARTS_SCHEMA": PRODUCTION_MARTS_SCHEMA},
+        append_env=True,  # keep the database settings the task already has
         # A rejected model is not a glitch, so trying again an hour later would only repeat it.
         retries=0,
     )
