@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Builds the website and restarts it. Run on the server after `git pull`.
+set -euo pipefail
+cd "$(dirname "$0")/../frontend"
+export NEXT_TELEMETRY_DISABLED=1
+npm ci
+npm run build
+systemctl restart planting-web
+echo "Website rebuilt and restarted."
diff --git a/deploy/planting-web.service b/deploy/planting-web.service
new file mode 100644
index 0000000..3a1e42e
--- /dev/null
+++ b/deploy/planting-web.service
@@ -0,0 +1,16 @@
+# systemd unit for the website (Next.js). Install: see frontend/README.md
+[Unit]
+Description=Planting Intelligence website
+After=network-online.target planting-api.service
+
+[Service]
+WorkingDirectory=/root/agritech/frontend
+Environment=NODE_ENV=production
+Environment=NEXT_TELEMETRY_DISABLED=1
+# The website asks the API from the server itself, so the browser never needs to reach the API.
+Environment=API_URL=http://127.0.0.1:8000
+ExecStart=/root/agritech/frontend/node_modules/.bin/next start --hostname 127.0.0.1 --port 3000
+Restart=on-failure
+
+[Install]
+WantedBy=multi-user.target
