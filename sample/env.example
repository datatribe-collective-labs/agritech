# .env  —  Copy this file, fill in your values, NEVER commit to git
# ---------------------------------------------------------------
# Docker Compose reads this file automatically.

# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Database connection — Python scripts (fetch_*.py, ml/, api/, ai/) ──
# Used by scripts/db_utils.py and ml/utils/db.py.
# If unset, falls back to local Postgres (localhost:5432/planting_db).
# For UpCloud, use the full connection string from the "Connect" panel
# on your database instance, converted to SQLAlchemy's format:
#   postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
PLANTING_DB_CONN=postgresql+psycopg2://upadmin:YOUR_PASSWORD_HERE@planting-db-ypismqtitqdz.db.upclouddatabases.com:11569/defaultdb?sslmode=require

# ── Database connection — dbt specifically ──────────────────────
# IMPORTANT: dbt does NOT read PLANTING_DB_CONN above — it's a
# completely separate config path via dbt/profiles.yml. These vars
# only matter if profiles.yml's target is set to 'prod' (it defaults
# to 'dev', which points at local Docker Postgres).
PROD_DB_HOST=planting-db-ypismqtitqdz.db.upclouddatabases.com
PROD_DB_PORT=11569
PROD_DB_USER=upadmin
PROD_DB_PASSWORD=YOUR_PASSWORD_HERE
PROD_DB_NAME=defaultdb
