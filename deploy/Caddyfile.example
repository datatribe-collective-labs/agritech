# /etc/caddy/Caddyfile  (replace the IP with the server's; dots become dashes)

# The API
94-237-15-238.sslip.io {
    reverse_proxy 127.0.0.1:8000
}

# The website farmers open (Next.js, started by planting-web.service)
app.94-237-15-238.sslip.io {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy 127.0.0.1:3000
}
