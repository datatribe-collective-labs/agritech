# systemd unit for the website (Next.js). Install: see frontend/README.md
[Unit]
Description=Planting Intelligence website
After=network-online.target planting-api.service

[Service]
WorkingDirectory=/root/agritech/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# The website asks the API from the server itself, so the browser never needs to reach the API.
Environment=API_URL=http://127.0.0.1:8000
ExecStart=/root/agritech/frontend/node_modules/.bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure

[Install]
WantedBy=multi-user.target
